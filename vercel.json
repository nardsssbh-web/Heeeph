{
  "functions": {
    "api/frete.js": {
      "includeFiles": "{produtos.js,config/frete.json,js/embalagens.js}",
      "maxDuration": 15
    },
    "api/checkout.js": {
      "includeFiles": "{produtos.js,config/frete.json,js/embalagens.js}",
      "maxDuration": 60
    },
    "api/mercado-pago-webhook.js": {
      "includeFiles": "{produtos.js,config/frete.json,js/embalagens.js}",
      "maxDuration": 60
    },
    "api/pedidos.js": {
      "includeFiles": "{produtos.js,config/frete.json,js/embalagens.js}",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(pagamento|pedidos).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
